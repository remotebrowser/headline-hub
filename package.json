{
  "name": "headline-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --import ./src/server/instrument.ts src/server.ts",
    "dev:server-only": "tsx watch --import ./src/server/instrument.ts src/server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc src/server.ts --outDir dist --module ESNext --target ES2022 --moduleResolution bundler --allowImportingTsExtensions false && cp -r src/server/patterns dist/server/patterns",
    "start": "NODE_ENV=production node --import ./dist/server/instrument.js dist/server.js",
    "preview": "npm run build && npm start",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@pydantic/logfire-node": "^0.21.1",
    "@sentry/node": "^10.15.0",
    "@tailwindcss/vite": "^4.1.10",
    "consola": "^3.4.2",
    "dotenv": "^16.3.1",
    "hono": "^4.13.5",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.2",
    "concurrently": "^9.2.0",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.4.5"
  },
  "volta": {
    "node": "22.18.0"
  }
}
